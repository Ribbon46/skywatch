{
  "id": "/skywatch/",
  "name": "SkyWatch — Astrophotography Planner",
  "short_name": "SkyWatch",
  "description": "Live cloud forecasts, moon, deep-sky targets, camera calculators, AR sky overlay, and session log for astrophotography. Works offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["tabbed", "window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#05060b",
  "theme_color": "#05060b",
  "categories": ["photo", "utilities", "education"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "edge_side_panel": { "preferred_width": 480 },
  "handle_links": "preferred",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "shared_title", "text": "shared_text", "url": "shared_url" }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/json": [".json"] },
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    { "protocol": "web+skywatch", "url": "./?spot=%s" }
  ],
  "icons": [
    { "src": "icon.svg",     "sizes": "any",     "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png",     "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png",     "purpose": "any" },
    { "src": "icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-monochrome.svg",   "sizes": "any",     "type": "image/svg+xml", "purpose": "monochrome" }
  ],
  "screenshots": [
    { "src": "screenshots/tonight.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Tonight verdict + key facts" },
    { "src": "screenshots/planner.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Planner — tiered observing spots" },
    { "src": "screenshots/sky.png",     "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Live sky + AR launch" },
    { "src": "screenshots/gear.png",    "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Smart Setup — auto-generated camera recipe" },
    { "src": "screenshots/wide-tonight.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide",   "label": "Tonight tab on desktop" },
    { "src": "screenshots/wide-planner.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide",   "label": "Planner tab on desktop" }
  ],
  "shortcuts": [
    { "name": "Tonight", "url": "./#tonight", "short_name": "Tonight", "description": "Tonight's go/no-go verdict",
      "icons": [{"src":"icon-192.png","sizes":"192x192","type":"image/png"}] },
    { "name": "Plan",    "url": "./#planner", "short_name": "Plan",    "description": "Find observing spots near you",
      "icons": [{"src":"icon-192.png","sizes":"192x192","type":"image/png"}] },
    { "name": "Sky now", "url": "./#sky",     "short_name": "Sky",     "description": "Live altitude/azimuth + AR",
      "icons": [{"src":"icon-192.png","sizes":"192x192","type":"image/png"}] },
    { "name": "Gear",    "url": "./#gear",    "short_name": "Gear",    "description": "Smart camera setup",
      "icons": [{"src":"icon-192.png","sizes":"192x192","type":"image/png"}] }
  ]
}
